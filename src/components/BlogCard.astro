---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  label?: string;
}
const { href, title, description, pubDate, tags = [], label } = Astro.props;
const date = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<article class="blog-card">
  <div class="blog-card-meta">
    <time datetime={pubDate.toISOString()}>{date}</time>
    {label && <span class="status-pill">{label}</span>}
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li><a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>)}
    </ul>
  )}
</article>
