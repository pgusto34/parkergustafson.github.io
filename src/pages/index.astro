---
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = "Coming Soon — Parker Gustafson";
const description = "Parker Gustafson’s new portfolio is coming soon.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101312" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Parker Gustafson" />
    <title>{pageTitle}</title>
  </head>
  <body class="coming-soon-body">
    <main class="coming-soon-main">
      <div class="coming-soon-mark" aria-hidden="true">PG</div>
      <div class="coming-soon-copy">
        <p class="eyebrow">Parker Gustafson</p>
        <h1>Something thoughtful<br /><em>is taking shape.</em></h1>
        <p>A new home for projects, research, and writing is coming soon.</p>
      </div>
      <div class="coming-soon-status">
        <span class="signal" aria-hidden="true"></span>
        <span>In progress</span>
      </div>
    </main>
  </body>
</html>
