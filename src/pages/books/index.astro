---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
---
<BaseLayout title="Books" description="Books and reading notes from Parker Gustafson.">
  <header class="page-intro page-shell"><p class="eyebrow">Books</p><h1>Ideas from the margins.</h1><p>A curated reading shelf, with space for the notes that made each book matter.</p></header>
